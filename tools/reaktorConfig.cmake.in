get_filename_component(_reaktor_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET reaktor::reaktor)
    add_library(reaktor::reaktor STATIC IMPORTED)
    set_target_properties(reaktor::reaktor PROPERTIES
        IMPORTED_LOCATION "${_reaktor_prefix}/lib/@REAKTOR_LIB_NAME@"
        IMPORTED_LINK_INTERFACE_LANGUAGES "C"
        INTERFACE_INCLUDE_DIRECTORIES "${_reaktor_prefix}/include"
        INTERFACE_LINK_LIBRARIES "@REAKTOR_LINK_LIBS@"
        INTERFACE_LINK_DIRECTORIES "@REAKTOR_LINK_DIRS@"
        INTERFACE_LINK_OPTIONS "@REAKTOR_LINK_OPTIONS@")
endif()
# The shared variant, where it is installed: the modules go into the app,
# after libreaktor.so so they fill in what it calls, and the app
# exports them back to it. The rpath finds the libraries wherever the
# prefix is, /opt/reaktor included, which the loader does not search.
# OpenBSD installs no unversioned libreaktor.so, so the first match is taken.
file(GLOB _reaktor_so "${_reaktor_prefix}/lib/libreaktor.so*")
file(GLOB _reaktor_sdl "${_reaktor_prefix}/lib/libreaktor-sdl3.so*")
if(NOT TARGET reaktor::shared AND _reaktor_so AND _reaktor_sdl)
    list(GET _reaktor_so 0 _reaktor_so)
    list(GET _reaktor_sdl 0 _reaktor_sdl)
    add_library(reaktor::shared INTERFACE IMPORTED)
    set_target_properties(reaktor::shared PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_reaktor_prefix}/include"
        INTERFACE_LINK_LIBRARIES "${_reaktor_so};${_reaktor_prefix}/lib/libreaktor-modules.a;${_reaktor_sdl};@REAKTOR_LINK_LIBS@"
        INTERFACE_LINK_DIRECTORIES "@REAKTOR_LINK_DIRS@"
        INTERFACE_LINK_OPTIONS "-Wl,--export-dynamic;-Wl,-rpath,${_reaktor_prefix}/lib;@REAKTOR_LINK_OPTIONS@")
endif()
# On macOS, Reaktor.framework, with SDL inside. The rpath looks beside the
# install first, then in /Library/Frameworks, where apps share one copy. The
# modules archive is loaded whole: ld64 takes from an archive only what the
# app calls, never what the framework calls back, as GNU ld does for a .so.
if(NOT TARGET reaktor::shared AND EXISTS "${_reaktor_prefix}/Frameworks/Reaktor.framework")
    add_library(reaktor::shared INTERFACE IMPORTED)
    set_target_properties(reaktor::shared PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_reaktor_prefix}/include"
        INTERFACE_LINK_LIBRARIES "${_reaktor_prefix}/Frameworks/Reaktor.framework;-Wl,-force_load,${_reaktor_prefix}/lib/libreaktor-modules.a;@REAKTOR_LINK_LIBS@"
        INTERFACE_LINK_DIRECTORIES "@REAKTOR_LINK_DIRS@"
        INTERFACE_LINK_OPTIONS "-Wl,-export_dynamic;-Wl,-rpath,${_reaktor_prefix}/Frameworks;-Wl,-rpath,/Library/Frameworks;@REAKTOR_LINK_OPTIONS@")
endif()
unset(_reaktor_prefix)
unset(_reaktor_so)
unset(_reaktor_sdl)

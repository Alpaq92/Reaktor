# Cross-compiling for NetBSD on arm64 from a NetBSD x86-64 host with pkgsrc clang and lld:
#   cmake -DCMAKE_TOOLCHAIN_FILE=tools/cross/netbsd-aarch64.cmake -DREAKTOR_SYSROOT=<dir>
# The sysroot is the evbarm-aarch64 sets plus the packages tools/cross/sysroot.sh gathers.
set(CMAKE_SYSTEM_NAME NetBSD)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES REAKTOR_SYSROOT)
set(CMAKE_SYSROOT "${REAKTOR_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64--netbsd)
set(CMAKE_CXX_COMPILER_TARGET aarch64--netbsd)
find_program(_llvm_ar NAMES llvm-ar)
find_program(_llvm_ranlib NAMES llvm-ranlib)
if(_llvm_ar)
    set(CMAKE_AR "${_llvm_ar}")
endif()
if(_llvm_ranlib)
    set(CMAKE_RANLIB "${_llvm_ranlib}")
endif()
# X11 lives under /usr/X11R7 and packages under /usr/pkg, and NetBSD links both
# directly, so the program carries their run paths.
set(CMAKE_C_FLAGS_INIT "-I${REAKTOR_SYSROOT}/usr/X11R7/include -I${REAKTOR_SYSROOT}/usr/pkg/include")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${REAKTOR_SYSROOT}/usr/X11R7/lib -L${REAKTOR_SYSROOT}/usr/pkg/lib -Wl,-rpath,/usr/X11R7/lib -Wl,-rpath,/usr/pkg/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${REAKTOR_SYSROOT}" "${REAKTOR_SYSROOT}/usr/pkg" "${REAKTOR_SYSROOT}/usr/X11R7")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG} pkgconf)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${REAKTOR_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${REAKTOR_SYSROOT}/usr/pkg/lib/pkgconfig:${REAKTOR_SYSROOT}/usr/pkg/share/pkgconfig:${REAKTOR_SYSROOT}/usr/X11R7/lib/pkgconfig:${REAKTOR_SYSROOT}/usr/X11R7/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH OFF)
